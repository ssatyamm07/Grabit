PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://grabit:grabit@localhost:5434/grabit
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=false
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:5173
RATE_LIMIT_MAX=300

# Realtime — Socket.IO is FREE. Prefer ON (live push). OFF = REST once + manual refresh (no poll).
SOCKET_ENABLED=true

# OTP — required live (MSG91). Do not dry-run in production.
SHOW_OTP_IN_RESPONSE=true
OTP_DRY_RUN=true
OTP_RATE_MAX=5
OTP_RATE_WINDOW_MS=900000
OTP_VERIFY_MAX=20
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=GRABIT
SMS_DRY_RUN=true
# Optional savings only: order status SMS off → free Expo push. OTP unchanged.
SMS_ORDER_UPDATES=false

# Google Maps — required live. Caching cuts repeat spend, not features.
GOOGLE_MAPS_API_KEY=
MAPS_RATE_MAX_PER_MIN=20
# auto = Matrix for delivery quotes; haversine for high-frequency tracking polls
MAPS_DISTANCE_MODE=auto
DEFAULT_DELIVERY_FEE_PAISE=2000

# Payments — Razorpay required live (COD still available as method).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMMISSION_RATE_BPS=1000

# Push / outbox — Expo push is free at pilot scale
PUSH_DRY_RUN=true
EXPO_ACCESS_TOKEN=
OUTBOX_BATCH=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_MS=2000

# Order auto-expire (unaccepted placed → expired + stock release)
ORDER_ACCEPT_TTL_MINUTES=30
ORDER_EXPIRE_BATCH=50
ORDER_EXPIRE_POLL_MS=60000

# Object storage — MinIO for local; S3 required for live
STORAGE_DRIVER=minio
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://127.0.0.1:9010
MINIO_BUCKET_PRODUCTS=products
# Live: STORAGE_DRIVER=s3
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=grabit-products
# S3_PUBLIC_URL=https://grabit-products.s3.ap-south-1.amazonaws.com

SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
BACKUP_DIR=./backups
